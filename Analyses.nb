Cell[CellGroupData[{

Cell["\<\
Iterative procedure for obtaining a convergence-stable resident trait \
schedule vector\
\>", "Subsection",
 CellChangeTimes->{{3.990162243388275*^9, 3.990162259339028*^9}, {
   3.990162295988662*^9, 3.990162297124264*^9}, {3.9901780073838673`*^9, 
   3.990178009965007*^9}, 
   3.99017827046272*^9},ExpressionUUID->"46832166-5bb6-4581-bc8d-\
8075c27acfd7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Iterate", " ", "the", " ", "age"}], "-", 
    RowBox[{
    "specific", " ", "learning", " ", "strategy", " ", "using", " ", "the", 
     " ", "selection", " ", 
     RowBox[{"gradient", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"IterateGradient", "[", 
     RowBox[{
     "listk0_", ",", "listn0_", ",", "Lu_", ",", "params_", ",", "Var_"}], 
     "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "na", ",", "da", ",", "LuNew", ",", "AgeGrad", ",", "L\[Nu]", ",", 
        "Ls", ",", "L\[Phi]", ",", "neq", ",", "Lk"}], "}"}], ",", 
      RowBox[{
       RowBox[{"na", "=", 
        RowBox[{"Length", "[", "Lu", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"da", "=", 
        RowBox[{"1", "/", 
         RowBox[{"(", 
          RowBox[{"na", "-", "1"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"L\[Nu]", ",", "Ls", ",", "L\[Phi]"}], "}"}], "=", 
        RowBox[{"Transpose", "[", "Lu", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"neq", ",", "Lk", ",", "AgeGrad"}], "}"}], "=", 
        RowBox[{"GetAgeGradient", "[", 
         RowBox[{"listk0", ",", "listn0", ",", "Lu", ",", "params"}], "]"}]}],
        ";", "\[IndentingNewLine]", 
       RowBox[{"LuNew", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Clip", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"L\[Nu]", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "+", 
               RowBox[{"Var", "*", 
                RowBox[{"AgeGrad", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", ",", "1"}], "]"}], "]"}]}]}], ",", 
              RowBox[{"{", 
               RowBox[{"0", ",", "1"}], "}"}]}], "]"}], ",", 
            RowBox[{"Clip", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Ls", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "+", 
               RowBox[{"Var", "*", 
                RowBox[{"AgeGrad", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", ",", "2"}], "]"}], "]"}]}]}], ",", 
              RowBox[{"{", 
               RowBox[{"0", ",", "1"}], "}"}]}], "]"}], ",", 
            RowBox[{"Clip", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"L\[Phi]", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "+", 
               RowBox[{"Var", "*", 
                RowBox[{"AgeGrad", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", ",", "3"}], "]"}], "]"}]}]}], ",", 
              RowBox[{"{", 
               RowBox[{"0", ",", "1"}], "}"}]}], "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", "na"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"neq", ",", "Lk", ",", "LuNew"}], "}"}]}]}], "]"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Iterate", " ", "the", " ", "age"}], "-", 
     RowBox[{"specific", " ", "learning", " ", "strategy", " ", "over", " ", 
      RowBox[{"time", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"IterateSeveralGen", "[", 
     RowBox[{"Lu_", ",", "params_", ",", "n_", ",", " ", "Var_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "LuEvoUpdate", ",", "LuEvo", ",", "Index", ",", "\[CapitalDelta]", ",",
         "i", ",", "na", ",", "da", ",", "k0Num", ",", "n0Num", ",", "listk", 
        ",", "listn", ",", "neq", ",", "Lk", ",", "lNum", ",", "lm", ",", 
        "\[Mu]N", ",", "\[Epsilon]"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Initialize", " ", "evolving", " ", "trait", " ", "list", " ", "with", 
        " ", "input", " ", "Lu"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"LuEvo", "=", "Lu"}], ";", "\[IndentingNewLine]", 
       RowBox[{"i", "=", "1"}], ";", "\[IndentingNewLine]", 
       RowBox[{"\[CapitalDelta]", "=", "1"}], ";", " ", 
       RowBox[{"(*", 
        RowBox[{"initialize", " ", "with", " ", "something", " ", "large"}], 
        "*)"}], "\n", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Age", " ", "grid", " ", "setup"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"na", "=", 
        RowBox[{"Length", "[", "Lu", "]"}]}], ";", " ", 
       RowBox[{"da", "=", 
        RowBox[{"1", "/", 
         RowBox[{"(", 
          RowBox[{"na", "-", "1"}], ")"}]}]}], 
       RowBox[{"(*", 
        RowBox[{"set", " ", "the", " ", "age", " ", "step", " ", "size"}], 
        "*)"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"\[Mu]N", "=", 
        RowBox[{"N", "[", 
         RowBox[{"\[Mu]", "/.", "params"}], "]"}]}], ";", 
       RowBox[{
        RowBox[{"lNum", "[", "a_", "]"}], ":=", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{
          RowBox[{"-", "a"}], " ", "\[Mu]N"}]]}], 
       RowBox[{"(*", 
        RowBox[{
        "Probability", " ", "of", " ", "surving", " ", "to", " ", "age", " ", 
         "a"}], "*)"}], ";", "\[IndentingNewLine]", 
       RowBox[{"lm", "=", 
        RowBox[{"N", "[", 
         FractionBox[
          RowBox[{"1", "-", 
           SuperscriptBox["\[ExponentialE]", 
            RowBox[{"-", " ", "\[Mu]N"}]]}], "\[Mu]N"], "]"}]}], 
       RowBox[{"(*", 
        RowBox[{
        "Average", " ", "survival", " ", "probability", " ", "over", " ", 
         "the", " ", "lifespan"}], "*)"}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"k0Num", "=", 
        RowBox[{"k0", "/.", "params"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"n0Num", "=", 
        RowBox[{"n0", "/.", "params"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"listk", "=", 
        RowBox[{"Table", "[", 
         RowBox[{"k0Num", ",", 
          RowBox[{"{", 
           RowBox[{"a", ",", 
            RowBox[{"Range", "[", 
             RowBox[{"0", ",", "1", ",", "da"}], "]"}]}], "}"}]}], "]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"listn", "=", 
        RowBox[{"Table", "[", 
         RowBox[{"n0Num", ",", 
          RowBox[{"{", 
           RowBox[{"a", ",", 
            RowBox[{"Range", "[", 
             RowBox[{"0", ",", "1", ",", "da"}], "]"}]}], "}"}]}], "]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"\[Epsilon]", "=", "0.001"}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"While", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"\[CapitalDelta]", ">", 
           RowBox[{"\[Epsilon]", " ", "Var"}]}], "&&", 
          RowBox[{"i", "<", "n"}]}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"neq", ",", "Lk", ",", "LuEvoUpdate"}], "}"}], "=", 
           RowBox[{"IterateGradient", "[", 
            RowBox[{
            "listk", ",", "listn", ",", "LuEvo", ",", "params", ",", " ", 
             "Var"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"\[CapitalDelta]", "=", 
           RowBox[{
            RowBox[{"Norm", "[", 
             RowBox[{
              RowBox[{"Flatten", "[", 
               RowBox[{"LuEvoUpdate", "-", "LuEvo"}], "]"}], ",", "1"}], 
             "]"}], "/", 
            RowBox[{"Length", "[", 
             RowBox[{"Flatten", "[", "LuEvo", "]"}], "]"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"LuEvo", ",", "listk", ",", "listn"}], "}"}], "=", 
           RowBox[{"{", 
            RowBox[{"LuEvoUpdate", ",", "Lk", ",", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"neq", " ", 
                RowBox[{
                 RowBox[{"lNum", "[", "a", "]"}], "/", "lm"}]}], ",", 
               RowBox[{"{", 
                RowBox[{"a", ",", 
                 RowBox[{"Range", "[", 
                  RowBox[{"0", ",", "1", ",", "da"}], "]"}]}], "}"}]}], 
              "]"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"i", "++"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"i", "==", "n"}], ",", 
         RowBox[{"Print", "[", 
          RowBox[{
          "\"\<maximal numbers of iterations reached, \[CapitalDelta] = \>\"",
            ",", " ", 
           RowBox[{"\[CapitalDelta]", " ", "/", " ", "Var"}], ",", " ", 
           "\"\< > \>\"", ",", " ", "\[Epsilon]"}], "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"i", ",", " ", "\"\< iterations\>\""}], "]"}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "Return", " ", "the", " ", "evolved", " ", "trait", " ", "list", " ", 
         "after", " ", "n", " ", "generations"}], "*)"}], 
       "\[IndentingNewLine]", "LuEvo"}]}], "\[IndentingNewLine]", 
     "]"}]}]}]}]], "Input",
 InitializationCell->True,
