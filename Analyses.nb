            RowBox[{"l", "[", "a", "]"}]}]}], ",", 
          RowBox[{
           RowBox[{"l", "[", "0", "]"}], "==", "1"}]}], "}"}], ",", 
        RowBox[{"l", "[", "a", "]"}], ",", "a"}], "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
