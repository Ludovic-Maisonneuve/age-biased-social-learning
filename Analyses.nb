            RowBox[{"[", "ia", "]"}], "]"}], " ", "\[Beta]N", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"A", "[", 
               RowBox[{"a", ",", "\[CurlyPhi]num"}], "]"}], " ", 
              RowBox[{
               RowBox[{"kI", "'"}], "[", "\[CurlyPhi]num", "]"}]}], "+", " ", 
             
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"kI", "[", "\[CurlyPhi]num", "]"}], "-", 
                RowBox[{"Lk", "[", 
                 RowBox[{"[", "ia", "]"}], "]"}]}], ")"}], " ", 
              RowBox[{"dA", "[", 
               RowBox[{"a", ",", "\[CurlyPhi]num"}], "]"}]}]}], ")"}]}]}], 
         ";"}], "\[IndentingNewLine]", ",", 
        RowBox[{"{", 
         RowBox[{"a", ",", "0", ",", "1", ",", "da"}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"neq", ",", "Lk", ",", "sGrid"}], "}"}]}]}], 
    "\[IndentingNewLine]", "]"}]}]}]], "Input",
