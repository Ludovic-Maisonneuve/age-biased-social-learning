       "*)"}], ";", "\[IndentingNewLine]", 
      RowBox[{"eps", "=", "0.001"}], " ", 
      RowBox[{"(*", 
       RowBox[{"Convergence", " ", "tolerance"}], "*)"}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"While", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"\[CapitalDelta]", ">", 
