                    RowBox[{"{", 
                    RowBox[{"at", ",", 
                    RowBox[{"Range", "[", 
                    RowBox[{"da", ",", "1", ",", "da"}], "]"}]}], "}"}]}], 
                   "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"babyBorned", "=", 
                RowBox[{"da", "  ", "cN", " ", 
                 RowBox[{"Dens", "[", "neq", "]"}], 
                 RowBox[{"Total", "[", 
                  RowBox[{"Table", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"nGridNew", "[", 
                    RowBox[{"[", "iat", "]"}], "]"}], 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"P", "[", 
                    RowBox[{
                    RowBox[{"fbValues", "[", 
                    RowBox[{"[", "iat", "]"}], "]"}], ",", 
                    RowBox[{"kGridNew", "[", 
                    RowBox[{"[", "iat", "]"}], "]"}]}], "]"}], "-", "MN"}], 
